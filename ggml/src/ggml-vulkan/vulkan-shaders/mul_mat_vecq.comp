#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if (defined(DATA_A_Q4_0R) && defined(Q4_0R_K32)) || defined(DATA_A_Q5_KR) || defined(DATA_A_Q8_0R)
#define K_PER_ITER 32
#elif defined(DATA_A_Q4_0R)
#define K_PER_ITER 16
#elif defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#else
#error unimplemented
#endif

uint a_offset, b_offset, d_offset;

int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

#include "mul_mat_vecq_funcs.glsl"

#if defined(DATA_A_Q5_KR)
// scale and min of sub-block j (0..7) from the 12 packed bytes in hdr.yzw, branch-free
void r5_scale_min(const uvec4 hdr, const uint j, out float sc, out float m) {
    const uint sh = 8 * (j & 3);
    const uint y = hdr.y >> sh;
    const uint z = hdr.z >> sh;
    const uint w = (hdr.w >> sh) & 0xFF;
    const bool lo = j < 4;
    sc = float(lo ? (y & 63) : ((w & 15) | (((y >> 6) & 3) << 4)));
    m  = float(lo ? (z & 63) : ((w >> 4) | (((z >> 6) & 3) << 4)));
}
#endif

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint first_row, const uint num_rows, const uint col, const uint b_qs_idx) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        // Preload data_b block
        const uint b_block_idx = (j*p.batch_stride_b + col) / QUANT_K_Q8_1 + b_offset;
        const uint b_block_idx_outer = b_block_idx / 4;
        const uint b_block_idx_inner = b_block_idx % 4;
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if defined(A_REORDERED_K32)
        // Each thread takes a whole block (16 quant bytes, one 16-byte load); the matching 32 q8_1
        // values are two 16-byte loads
        {
            const uint bv = b_block_idx_outer * 9 + 1 + b_block_idx_inner * 2;
            const ivec4 b0 = data_b_r128[bv];
            const ivec4 b1 = data_b_r128[bv + 1];
            cache_b_qs[0] = b0.x; cache_b_qs[1] = b0.y; cache_b_qs[2] = b0.z; cache_b_qs[3] = b0.w;
            cache_b_qs[4] = b1.x; cache_b_qs[5] = b1.y; cache_b_qs[6] = b1.z; cache_b_qs[7] = b1.w;
        }
#elif defined(DATA_A_Q4_0R)
        // Each thread takes half a block (8 quant bytes = 16 values): low nibbles pair with
        // q8_1 ints 2h, 2h+1 and high nibbles with ints 4+2h, 5+2h.
        {
            const uint bq = b_block_idx_inner * 8 + b_qs_idx * 2;
            cache_b_qs[0] = data_b[b_block_idx_outer].qs[bq    ];
            cache_b_qs[1] = data_b[b_block_idx_outer].qs[bq + 1];
            cache_b_qs[2] = data_b[b_block_idx_outer].qs[bq + 4];
            cache_b_qs[3] = data_b[b_block_idx_outer].qs[bq + 5];
        }
#elif QUANT_R == 2
        // Assumes K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#else
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];
#elif K_PER_ITER == 32
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 3];
        cache_b_qs[4] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 4];
        cache_b_qs[5] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 5];
        cache_b_qs[6] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 6];
        cache_b_qs[7] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 7];
#else
#error unimplemented
#endif
#endif

#if defined(DATA_A_Q5_KR)
        // one 32-value sub-block per thread: 16 quant bytes, its 32 high bits, the superblock header
        const uint nb = p.ncols / QUANT_K;
        const uint js = col / 32;
        const uint jb = js / 8;
        uint rsb = first_row * nb + a_offset / (QUANT_K / QUANT_K_Q8_1);
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uvec4 q = data_a_r128[rsb * 11 + js];
            const uint qh = data_a_r32[rsb * 44 + nb * 32 + js];
            const uvec4 hdr = data_a_r128[rsb * 11 + nb * 10 + jb];
            rsb += nb;

            int32_t q_sum = 0;
            [[unroll]] for (uint w = 0; w < 4; ++w) {
                q_sum += dotPacked4x8EXT(int32_t(( q[w]       & 0x0F0F0F0F) | (((qh >> w)       & 0x01010101) << 4)), cache_b_qs[w]);
                q_sum += dotPacked4x8EXT(int32_t(((q[w] >> 4) & 0x0F0F0F0F) | (((qh >> (w + 4)) & 0x01010101) << 4)), cache_b_qs[w + 4]);
            }
            const vec2 dm = unpackHalf2x16(hdr.x);
            float sc, mn;
            r5_scale_min(hdr, js % 8, sc, mn);
            temp[j][n] += FLOAT_TYPE(dm.x * sc * (float(q_sum) * cache_b_ds.x) - dm.y * mn * cache_b_ds.y);
        }
#elif defined(DATA_A_Q8_0R)
        // one 32-value block per thread: two 16-byte loads and the fp16 scale
        const uint nbpr = p.ncols / QUANT_K;
        const uint jb = col / QUANT_K;
        // nbpr % 8 == 0, so a row starts 16-byte aligned: rsb*34/16 = rsb*17/8 is exact
        uint rsb = first_row * nbpr + a_offset;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint q4i = (rsb * 17) / 8 + 2 * jb;
            const uvec4 q0 = data_a_r128[q4i];
            const uvec4 q1 = data_a_r128[q4i + 1];
            const float da = float(data_a_r16[rsb * 17 + nbpr * 16 + jb]);
            rsb += nbpr;

            int32_t q_sum = dotPacked4x8EXT(int32_t(q0.x), cache_b_qs[0]);
            q_sum += dotPacked4x8EXT(int32_t(q0.y), cache_b_qs[1]);
            q_sum += dotPacked4x8EXT(int32_t(q0.z), cache_b_qs[2]);
            q_sum += dotPacked4x8EXT(int32_t(q0.w), cache_b_qs[3]);
            q_sum += dotPacked4x8EXT(int32_t(q1.x), cache_b_qs[4]);
            q_sum += dotPacked4x8EXT(int32_t(q1.y), cache_b_qs[5]);
            q_sum += dotPacked4x8EXT(int32_t(q1.z), cache_b_qs[6]);
            q_sum += dotPacked4x8EXT(int32_t(q1.w), cache_b_qs[7]);

            temp[j][n] += FLOAT_TYPE(da * (float(q_sum) * cache_b_ds.x));
        }
#elif defined(DATA_A_Q4_0R)
        const uint nbpr = p.ncols / QUANT_K;
        const uint jb = col / QUANT_K;
        // rsb = first block of the row = R*nbpr; nbpr % 4 == 0 so rsb*9/4 is exact
        uint rsb = first_row * nbpr + a_offset;
#if defined(Q4_0R_K32)
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            // nbpr % 8 == 0 so rsb*9/8 is exact
            const uvec4 q = data_a_r128[(rsb * 9) / 8 + jb];
            const float da = float(data_a_r16[rsb * 9 + nbpr * 8 + jb]);
            rsb += nbpr;

            int32_t q_sum = dotPacked4x8EXT(int32_t( q.x       & 0x0F0F0F0F), cache_b_qs[0]);
            q_sum += dotPacked4x8EXT(int32_t( q.y       & 0x0F0F0F0F), cache_b_qs[1]);
            q_sum += dotPacked4x8EXT(int32_t( q.z       & 0x0F0F0F0F), cache_b_qs[2]);
            q_sum += dotPacked4x8EXT(int32_t( q.w       & 0x0F0F0F0F), cache_b_qs[3]);
            q_sum += dotPacked4x8EXT(int32_t((q.x >> 4) & 0x0F0F0F0F), cache_b_qs[4]);
            q_sum += dotPacked4x8EXT(int32_t((q.y >> 4) & 0x0F0F0F0F), cache_b_qs[5]);
            q_sum += dotPacked4x8EXT(int32_t((q.z >> 4) & 0x0F0F0F0F), cache_b_qs[6]);
            q_sum += dotPacked4x8EXT(int32_t((q.w >> 4) & 0x0F0F0F0F), cache_b_qs[7]);

            temp[j][n] += FLOAT_TYPE(da * (float(q_sum) * cache_b_ds.x - 8.0 * cache_b_ds.y));
        }
#else
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uvec2 q = data_a_r64[(rsb * 9) / 4 + 2 * jb + b_qs_idx];
            const float da = float(data_a_r16[rsb * 9 + nbpr * 8 + jb]);
            rsb += nbpr;

            int32_t q_sum = dotPacked4x8EXT(int32_t( q.x       & 0x0F0F0F0F), cache_b_qs[0]);
            q_sum += dotPacked4x8EXT(int32_t( q.y       & 0x0F0F0F0F), cache_b_qs[1]);
            q_sum += dotPacked4x8EXT(int32_t((q.x >> 4) & 0x0F0F0F0F), cache_b_qs[2]);
            q_sum += dotPacked4x8EXT(int32_t((q.y >> 4) & 0x0F0F0F0F), cache_b_qs[3]);

            // 16 quants per call => the -8 offset contributes 8 * (16/32) = 4 times ds.y
            temp[j][n] += FLOAT_TYPE(da * (float(q_sum) * cache_b_ds.x - 4.0 * cache_b_ds.y));
        }
#endif
#else
        uint ibi = first_row*p.ncols;
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint a_block_idx = (ibi + col)/QUANT_K_Q8_1 + a_offset;
            ibi += p.ncols;

            temp[j][n] += mmvq_dot_product(a_block_idx, b_qs_idx);
        }
#endif
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint col = tid * K_PER_ITER;
    while (num_iters >= 4) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < 4; ++k) {
            iter(temp, first_row, num_rows, col, b_qs_idx);
            col += col_stride;
        }

        num_iters -= 4;
    }

    if (num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        iter(temp, first_row, num_rows, col, b_qs_idx);
        col += col_stride;
        num_iters -= 2;
    }

    if (num_iters > 0) {
        iter(temp, first_row, num_rows, col, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

#if (defined(DATA_A_Q5_K) || defined(DATA_A_Q4_K)) && !defined(MUL_MAT_ID) && !defined(DATA_A_Q5_KR)
// Wide K-quant path (KQ_WIDE != 0): 8 threads per superblock. Each thread owns 16 quant
// bytes (32 values: 16 low nibbles of sub-block 2g, 16 high nibbles of sub-block 2g+1),
// reads them, the 16-byte header and (Q5_K) its 16 bytes of high bits with 16-byte loads,
// builds int8 quads with a few bit ops and uses dotPacked4x8 against the q8_1 activations.
layout (constant_id = 3) const uint KQ_WIDE = 0;
layout (binding = 1) readonly buffer BI4 {ivec4 data_b_i4[];};
#if defined(DATA_A_Q5_K)
#define KQ_U128_PER_BLOCK 11
#else
#define KQ_U128_PER_BLOCK 9
#endif

// scale and min of sub-block j (0..7) from the 12 packed bytes in hdr.yzw, branch-free
void kq_scale_min(const uvec4 hdr, const uint j, out float sc, out float m) {
    const uint sh = 8 * (j & 3);
    const uint y = hdr.y >> sh;
    const uint z = hdr.z >> sh;
    const uint w = (hdr.w >> sh) & 0xFF;
    const bool lo = j < 4;
    sc = float(lo ? (y & 63) : ((w & 15) | (((y >> 6) & 3) << 4)));
    m  = float(lo ? (z & 63) : ((w >> 4) | (((z >> 6) & 3) << 4)));
}

int kq_dot4(const ivec4 a, const ivec4 b) {
    return dotPacked4x8EXT(a.x, b.x) + dotPacked4x8EXT(a.y, b.y) + dotPacked4x8EXT(a.z, b.z) + dotPacked4x8EXT(a.w, b.w);
}

void compute_outputs_kqwide(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;
    get_offsets(a_offset, b_offset, d_offset);   // a_offset in superblocks, b_offset in values

    const uint nb   = p.ncols / QUANT_K;
    const uint lane = tid % 8;
    const uint ix   = tid / 8;
    const uint it_size = gl_WorkGroupSize.x / 8;
    const uint g = lane >> 1;
    const uint h = lane & 1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    for (uint i = ix; i < nb; i += it_size) {
        ivec4 bl[NUM_COLS];
        ivec4 bh[NUM_COLS];
        float dbl[NUM_COLS];
        float dbh[NUM_COLS];
        float ysl[NUM_COLS];
        float ysh[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            const uint q8l = (j*p.batch_stride_b + b_offset + i*QUANT_K + 64*g) / 32;
            const uint q8h = q8l + 1;
            bl[j]  = data_b_i4[(q8l / 4) * 9 + 1 + (q8l % 4) * 2 + h];
            bh[j]  = data_b_i4[(q8h / 4) * 9 + 1 + (q8h % 4) * 2 + h];
            dbl[j] = float(data_b[q8l / 4].ds[q8l % 4].x);
            dbh[j] = float(data_b[q8h / 4].ds[q8h % 4].x);
            ysl[j] = dbl[j] * float(kq_dot4(ivec4(0x01010101), bl[j]));
            ysh[j] = dbh[j] * float(kq_dot4(ivec4(0x01010101), bh[j]));
        }

        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            const uint ib = (a_offset + (first_row + n) * nb + i) * KQ_U128_PER_BLOCK;
            const uvec4 hdr = data_a_u128[ib];
#if defined(DATA_A_Q5_K)
            const uvec4 qh4 = data_a_u128[ib + 1 + h];
            const uvec4 qs4 = data_a_u128[ib + 3 + 2*g + h];
            const ivec4 lo = ivec4((qs4 & 0x0F0F0F0F)        | (((qh4 >> (2*g))     & 0x01010101) << 4));
            const ivec4 hi = ivec4(((qs4 >> 4) & 0x0F0F0F0F) | (((qh4 >> (2*g + 1)) & 0x01010101) << 4));
#else
            const uvec4 qs4 = data_a_u128[ib + 1 + 2*g + h];
            const ivec4 lo = ivec4(qs4 & 0x0F0F0F0F);
            const ivec4 hi = ivec4((qs4 >> 4) & 0x0F0F0F0F);
#endif
            const vec2 dm = unpackHalf2x16(hdr.x);
            float sc_l, m_l, sc_h, m_h;
            kq_scale_min(hdr, 2*g,     sc_l, m_l);
            kq_scale_min(hdr, 2*g + 1, sc_h, m_h);

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const float sl = dbl[j] * float(kq_dot4(lo, bl[j]));
                const float sh = dbh[j] * float(kq_dot4(hi, bh[j]));
                temp[j][n] += FLOAT_TYPE(dm.x * (sc_l * sl + sc_h * sh) - dm.y * (m_l * ysl[j] + m_h * ysh[j]));
            }
        }
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}
#endif

void compute_any(const uint32_t first_row, const uint32_t num_rows) {
#if (defined(DATA_A_Q5_K) || defined(DATA_A_Q4_K)) && !defined(MUL_MAT_ID) && !defined(DATA_A_Q5_KR)
    if (KQ_WIDE != 0) {
        compute_outputs_kqwide(first_row, num_rows);
        return;
    }
#endif
    compute_outputs(first_row, num_rows);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_any(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_any(first_row, p.stride_d - first_row);
    }
}
