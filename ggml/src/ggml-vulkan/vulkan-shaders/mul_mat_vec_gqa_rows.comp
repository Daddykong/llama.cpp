#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

// dst[i, t, h*GQA + c] = sum_k A[k, i, h] * B[k, t, h*GQA + c]
// for a short k (e.g. K x Q in decode attention: k = head size, i = KV position).
// One invocation per row i: the row of A is read once and dotted with all GQA*NTOK
// columns of B, which are the same for the whole subgroup (broadcast loads).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "mul_mat_vec_iface.glsl"

layout(constant_id = 0) const uint GQA = 1;   // B channels per A channel, 1..8
layout(constant_id = 1) const uint NTOK = 1;  // columns of B, 1..4
layout(constant_id = 2) const uint R = 1;     // b65 [mtp]: rows per invocation (rows i, i+64, ...): each B load serves R rows

layout (push_constant) uniform parameter
{
    uint ncols;          // k, multiple of 4
    uint nrows;          // rows of A per channel
    uint a_row_stride;   // in elements, multiples of 4
    uint a_chan_stride;
    uint b_chan_stride;
    uint b_tok_stride;
    uint d_chan_stride;
    uint d_tok_stride;
    uint a_offset;
    uint b_offset;
    uint d_offset;
    uint mask_offset;       // b65 Quest v2 (flags & 4): selection bitmap at binding 3, word offset
    uint mask_tok_stride;   // words per token
    uint mask_head_stride;  // words per A channel (KV head)
    uint flags;
    uint qblock;            // cells per bit
} p;

layout (binding = 3) readonly buffer QBM {uint data_qbm[];};   // b65 Quest v2 (aliases Fuse0)

// bit t of the result: token t keeps block blk of A channel h
uint quest_bits(const uint h, const uint blk) {
    uint m = 0;
    [[unroll]] for (uint t = 0; t < NTOK; ++t) {
        m |= ((data_qbm[p.mask_offset + t * p.mask_tok_stride + h * p.mask_head_stride + blk / 32] >> (blk % 32)) & 1u) << t;
    }
    return m;
}

void main() {
    const uint row0 = gl_WorkGroupID.x * 64 * R + gl_LocalInvocationID.x;
    const uint h    = gl_WorkGroupID.y;
    if (row0 >= p.nrows) {
        return;
    }

    float acc[R * NTOK * GQA];
    [[unroll]] for (uint i = 0; i < R * NTOK * GQA; ++i) {
        acc[i] = 0.0;
    }

    uint a_base[R];
    [[unroll]] for (uint r = 0; r < R; ++r) {
        // rows past the end re-read row0; their results are not written
        const uint row = row0 + r * 64 < p.nrows ? row0 + r * 64 : row0;
        a_base[r] = (p.a_offset + h * p.a_chan_stride + row * p.a_row_stride) / 4;
    }
    const uint b_base = (p.b_offset + h * GQA * p.b_chan_stride) / 4;
    const uint b_cs   = p.b_chan_stride / 4;
    const uint b_ts   = p.b_tok_stride / 4;

    // b65 Quest v2 (K x Q): rows of unselected blocks are not read; their outputs are -inf
    const bool qsk = (p.flags & 4u) != 0u;
    uint qsel[R];
    bool qany = !qsk;
    [[unroll]] for (uint r = 0; r < R; ++r) {
        qsel[r] = (1u << NTOK) - 1u;
        if (qsk) {
            const uint row = row0 + r * 64;
            qsel[r] = row < p.nrows ? quest_bits(h, row / p.qblock) : 0u;
            qany = qany || qsel[r] != 0u;
        }
    }

    for (uint k4 = 0; qany && k4 < p.ncols / 4; ++k4) {
        vec4 av[R];
        [[unroll]] for (uint r = 0; r < R; ++r) {
            av[r] = vec4(data_a_v4[a_base[r] + k4]);
        }
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                const vec4 bv = data_b_v4[b_base + c * b_cs + t * b_ts + k4];
                [[unroll]] for (uint r = 0; r < R; ++r) {
                    acc[(r * NTOK + t) * GQA + c] += dot(av[r], bv);
                }
            }
        }
    }

    [[unroll]] for (uint r = 0; r < R; ++r) {
        const uint row = row0 + r * 64;
        if (row < p.nrows) {
            [[unroll]] for (uint t = 0; t < NTOK; ++t) {
                [[unroll]] for (uint c = 0; c < GQA; ++c) {
                    data_d[p.d_offset + (h * GQA + c) * p.d_chan_stride + t * p.d_tok_stride + row] =
                        ((qsel[r] >> t) & 1u) != 0u ? acc[(r * NTOK + t) * GQA + c] : uintBitsToFloat(0xFF800000u);
                }
            }
        }
    }
}
