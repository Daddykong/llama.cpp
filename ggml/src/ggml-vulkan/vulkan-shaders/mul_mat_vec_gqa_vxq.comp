#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// b65 kv4: V x P with a quantized V cache (flash attention off), pass 1 of 2.
//   part[s, h*GQA + c, t, i] = sum_{k in slice s} V[i, k, h] * P[t, k, h*GQA + c]
// i.e. ggml_out_prod(v, transpose(kq)). A quantized V cache cannot be stored transposed (its blocks run along the head
// dim), so V rows are tokens: d elements in d/32 blocks (q8_0, q4_0 or iq4_nl), read through a 16-bit view.
// A workgroup is one KV head and one k-slice: 128 lanes = R row groups of 256/EPL lanes; lane li of a row group owns
// elements EPL*li .. EPL*li+EPL-1 of every row, row group rg takes the slice's tokens rg, rg+R, ... in order, with the
// probabilities staged through shared memory (uniform reads). The R partial sums are added in a fixed order at the end;
// pass 2 (mul_mat_vec_gqa_vxp_reduce.comp) adds the slices in order. EPL/R and the slicing depend only on the
// pipeline's (GQA, NTOK) choice and on k and the head count; with EPL fixed for every NTOK (batch-invariant mode)
// 1-4 token steps give bit-identical results.

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint EPL = 2;     // elements per lane: 2, 4 or 8 (R = EPL/2 row groups)
layout(constant_id = 1) const uint GQA = 1;     // B channels per A channel, 1..8
layout(constant_id = 2) const uint NTOK = 1;    // columns of B, 1..4
layout(constant_id = 3) const uint KC = 64;     // tokens per staged probability tile

#define WG 128u
const uint LPR = 256u / EPL;   // lanes per row (head dim up to 256)
const uint R = WG / LPR;       // row groups

#if defined(DATA_A_Q8_0)
#define BU 17u
#else
#define BU 9u
#endif

layout (binding = 0) readonly buffer A {uint16_t data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter
{
    uint ncols;          // k (tokens of the cache)
    uint nrows;          // d (head dim), multiple of 32, <= 256
    uint a_row_stride;   // in blocks: one token row of the cache
    uint a_chan_stride;  // in blocks: one KV head
    uint b_chan_stride;  // in f32: one query head of P
    uint b_tok_stride;   // in f32: one query token of P (P is contiguous along k)
    uint a_offset;       // in blocks
    uint b_offset;       // in f32
    uint slice;          // k per slice, multiple of KC
    uint nchan_b;        // B channels (= A channels * GQA)
} p;

shared float btile[GQA * NTOK * KC];
shared float red[WG * EPL];

#if defined(DATA_A_IQ4_NL)
shared float kvalues[16];
const float kvalues_const[16] = float[16](-127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
                                          1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);
#endif

// EPL elements starting at in-block element e (a multiple of EPL) of block ib
void load_row(const uint ib, const uint e, out float v[EPL]) {
    const uint u = (p.a_offset + ib) * BU;
    const float d = unpackHalf2x16(uint(data_a[u])).x;
#if defined(DATA_A_Q8_0)
    [[unroll]] for (uint w = 0; w < EPL / 2; ++w) {
        const int q = int(int16_t(data_a[u + 1 + e / 2 + w]));
        v[2 * w]     = float((q << 24) >> 24) * d;
        v[2 * w + 1] = float(q >> 8) * d;
    }
#else
    const uint sh = e < 16 ? 0u : 4u;
    [[unroll]] for (uint w = 0; w < EPL / 2; ++w) {
        const uint q = uint(data_a[u + 1 + (e % 16) / 2 + w]);
        const uint n0 = (q >> sh) & 0xFu, n1 = (q >> (8 + sh)) & 0xFu;
#if defined(DATA_A_IQ4_NL)
        v[2 * w]     = kvalues[n0] * d;
        v[2 * w + 1] = kvalues[n1] * d;
#else
        v[2 * w]     = float(int(n0) - 8) * d;
        v[2 * w + 1] = float(int(n1) - 8) * d;
#endif
    }
#endif
}

void main() {
    const uint l  = gl_LocalInvocationID.x;
    const uint rg = l / LPR;
    const uint li = l % LPR;
    const uint s  = gl_WorkGroupID.x;
    const uint h  = gl_WorkGroupID.y;
    const uint k0 = s * p.slice;
    const uint k1 = min(k0 + p.slice, p.ncols);
    const uint e0 = EPL * li;              // first element (head dim) of this lane
    const bool live = e0 < p.nrows;

#if defined(DATA_A_IQ4_NL)
    if (l < 16) {
        kvalues[l] = kvalues_const[l];
    }
#endif

    float acc[EPL * GQA * NTOK];
    [[unroll]] for (uint i = 0; i < EPL * GQA * NTOK; ++i) acc[i] = 0.0;

    const uint a_base = h * p.a_chan_stride + e0 / 32;
    const uint eb = e0 % 32;
    const uint b_base = p.b_offset + h * GQA * p.b_chan_stride;

    for (uint kt = k0; kt < k1; kt += KC) {
        const uint kn = min(KC, k1 - kt);
        barrier();
        for (uint x = l; x < GQA * NTOK * KC; x += WG) {
            const uint kk = x % KC;
            const uint ct = x / KC;          // c * NTOK + t
            const uint c = ct / NTOK, t = ct % NTOK;
            btile[x] = kk < kn ? data_b[b_base + c * p.b_chan_stride + t * p.b_tok_stride + kt + kk] : 0.0;
        }
        barrier();
        if (live) {
            uint kk = rg;
            for (; kk + R < kn; kk += 2 * R) {
                float v0[EPL], v1[EPL];
                load_row(a_base + (kt + kk) * p.a_row_stride, eb, v0);
                load_row(a_base + (kt + kk + R) * p.a_row_stride, eb, v1);
                [[unroll]] for (uint ct = 0; ct < GQA * NTOK; ++ct) {
                    const float pb = btile[ct * KC + kk];
                    [[unroll]] for (uint j = 0; j < EPL; ++j) acc[ct * EPL + j] = fma(v0[j], pb, acc[ct * EPL + j]);
                }
                [[unroll]] for (uint ct = 0; ct < GQA * NTOK; ++ct) {
                    const float pb = btile[ct * KC + kk + R];
                    [[unroll]] for (uint j = 0; j < EPL; ++j) acc[ct * EPL + j] = fma(v1[j], pb, acc[ct * EPL + j]);
                }
            }
            if (kk < kn) {
                float v0[EPL];
                load_row(a_base + (kt + kk) * p.a_row_stride, eb, v0);
                [[unroll]] for (uint ct = 0; ct < GQA * NTOK; ++ct) {
                    const float pb = btile[ct * KC + kk];
                    [[unroll]] for (uint j = 0; j < EPL; ++j) acc[ct * EPL + j] = fma(v0[j], pb, acc[ct * EPL + j]);
                }
            }
        }
    }

    // part layout [slice][hq][t][i], as mul_mat_vec_gqa_vxp_reduce.comp reads it; row groups added in order 0..R-1
    [[unroll]] for (uint c = 0; c < GQA; ++c) {
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            const uint ct = c * NTOK + t;
            const uint o = ((s * p.nchan_b + h * GQA + c) * NTOK + t) * p.nrows;
            if (R == 1) {
                if (live) {
                    [[unroll]] for (uint j = 0; j < EPL; ++j) data_d[o + e0 + j] = acc[ct * EPL + j];
                }
            } else {
                barrier();
                [[unroll]] for (uint j = 0; j < EPL; ++j) red[rg * 256 + e0 + j] = acc[ct * EPL + j];
                barrier();
                for (uint i = l; i < p.nrows; i += WG) {
                    float sum = red[i];
                    for (uint r = 1; r < R; ++r) sum += red[r * 256 + i];
                    data_d[o + i] = sum;
                }
            }
        }
    }
}
