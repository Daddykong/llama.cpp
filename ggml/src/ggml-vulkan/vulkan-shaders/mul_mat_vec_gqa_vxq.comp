#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// b65 kv4: V x P with a quantized V cache (flash attention off), pass 1 of 2.
//   part[s, h*GQA + c, t, i] = sum_{k in slice s} V[i, k, h] * P[t, k, h*GQA + c]
// i.e. ggml_out_prod(v, transpose(kq)). A quantized V cache cannot be stored transposed (its blocks run along the head
// dim), so V rows are tokens: d elements in d/32 blocks. A workgroup is d/2 lanes on one KV head and one k-slice;
// lane l owns elements 2l, 2l+1 of every row (one 16-bit load + the block scale) and walks the slice's tokens in order,
// with the slice's probabilities staged through shared memory (uniform reads). Every output is a fixed-order fma chain
// over its slice, summed over the slices in order by pass 2 (mul_mat_vec_gqa_vxp_reduce.comp). The slicing depends
// only on k and the head count, never on the token count, so 1-4 token steps give bit-identical results.

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint WG = 128;    // lanes = d/2 (d <= 2*WG; lanes past d/2 idle)
layout(constant_id = 1) const uint GQA = 1;     // B channels per A channel, 1..8
layout(constant_id = 2) const uint NTOK = 1;    // columns of B, 1..4
layout(constant_id = 3) const uint KC = 64;     // tokens per staged probability tile

#if defined(DATA_A_Q8_0)
struct blk_t { float16_t d; int16_t qs[16]; };     // 34 bytes
#elif defined(DATA_A_Q4_0)
struct blk_t { float16_t d; uint16_t qs[8]; };     // 18 bytes
#endif

layout (binding = 0) readonly buffer A {blk_t data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter
{
    uint ncols;          // k (tokens of the cache)
    uint nrows;          // d (head dim), multiple of 32, <= 2*WG
    uint a_row_stride;   // in blocks: one token row of the cache
    uint a_chan_stride;  // in blocks: one KV head
    uint b_chan_stride;  // in f32: one query head of P
    uint b_tok_stride;   // in f32: one query token of P (P is contiguous along k)
    uint a_offset;       // in blocks
    uint b_offset;       // in f32
    uint slice;          // k per slice, multiple of KC
    uint nchan_b;        // B channels (= A channels * GQA)
} p;

shared float btile[GQA * NTOK * KC];

vec2 load_pair(const uint ib, const uint l) {
#if defined(DATA_A_Q8_0)
    const int q = int(data_a[ib].qs[l % 16]);           // elements 2l, 2l+1 of the block
    return vec2(float((q << 24) >> 24), float(q >> 8)) * float(data_a[ib].d);
#elif defined(DATA_A_Q4_0)
    const uint e = (2 * l) % 32;                        // element in the block: e, e+1
    const uint q = uint(data_a[ib].qs[(e % 16) / 2]);   // bytes e%16, e%16+1
    const uint sh = e < 16 ? 0u : 4u;
    return vec2(float(int((q >> sh) & 0xFu) - 8), float(int((q >> (8 + sh)) & 0xFu) - 8)) * float(data_a[ib].d);
#endif
}

void main() {
    const uint l  = gl_LocalInvocationID.x;
    const uint s  = gl_WorkGroupID.x;
    const uint h  = gl_WorkGroupID.y;
    const uint k0 = s * p.slice;
    const uint k1 = min(k0 + p.slice, p.ncols);
    const bool live = 2 * l < p.nrows;

    vec2 acc[GQA * NTOK];
    [[unroll]] for (uint i = 0; i < GQA * NTOK; ++i) acc[i] = vec2(0.0);

    const uint a_base = p.a_offset + h * p.a_chan_stride + (2 * l) / 32;
    const uint b_base = p.b_offset + h * GQA * p.b_chan_stride;

    for (uint kt = k0; kt < k1; kt += KC) {
        const uint kn = min(KC, k1 - kt);
        barrier();
        for (uint x = l; x < GQA * NTOK * KC; x += WG) {
            const uint kk = x % KC;
            const uint ct = x / KC;          // c * NTOK + t
            const uint c = ct / NTOK, t = ct % NTOK;
            btile[x] = kk < kn ? data_b[b_base + c * p.b_chan_stride + t * p.b_tok_stride + kt + kk] : 0.0;
        }
        barrier();
        if (live) {
            uint kk = 0;
            for (; kk + 4 <= kn; kk += 4) {
                vec2 v[4];
                [[unroll]] for (uint u = 0; u < 4; ++u) v[u] = load_pair(a_base + (kt + kk + u) * p.a_row_stride, l);
                [[unroll]] for (uint u = 0; u < 4; ++u) {
                    [[unroll]] for (uint ct = 0; ct < GQA * NTOK; ++ct) {
                        const float pb = btile[ct * KC + kk + u];
                        acc[ct] = fma(v[u], vec2(pb), acc[ct]);
                    }
                }
            }
            for (; kk < kn; ++kk) {
                const vec2 v = load_pair(a_base + (kt + kk) * p.a_row_stride, l);
                [[unroll]] for (uint ct = 0; ct < GQA * NTOK; ++ct) {
                    acc[ct] = fma(v, vec2(btile[ct * KC + kk]), acc[ct]);
                }
            }
        }
    }

    if (live) {
        // part layout [slice][hq][t][i], as mul_mat_vec_gqa_vxp_reduce.comp reads it
        [[unroll]] for (uint c = 0; c < GQA; ++c) {
            [[unroll]] for (uint t = 0; t < NTOK; ++t) {
                const uint o = ((s * p.nchan_b + h * GQA + c) * NTOK + t) * p.nrows + 2 * l;
                data_d[o]     = acc[c * NTOK + t].x;
                data_d[o + 1] = acc[c * NTOK + t].y;
            }
        }
    }
}
