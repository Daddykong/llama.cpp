#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// b65 v2 of mul_mat_vec_gqa_split: dst[i, t, h*GQA + c] = sum_k A[k, i, h] * B[k, t, h*GQA + c] for long k.
// Workgroup = 8 subgroups x 32 lanes (pipeline requires subgroup size 32); subgroup s owns rows
// row0 + s*NROWS .. +NROWS-1 and walks k with its 32 lanes; the subgroups of a workgroup share B via L1.
#define BLOCK_SIZE 256
#define SG 32
layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

#include "mul_mat_vec_iface.glsl"

layout(constant_id = 0) const uint GQA = 1;
layout(constant_id = 1) const uint NTOK = 1;
layout(constant_id = 2) const uint NROWS = 1;   // rows per subgroup

layout (push_constant) uniform parameter
{
    uint ncols; uint nrows; uint a_row_stride; uint a_chan_stride;
    uint b_chan_stride; uint b_tok_stride; uint d_chan_stride; uint d_tok_stride;
    uint a_offset; uint b_offset; uint d_offset;
} p;

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint sg   = gl_SubgroupID;
    const uint h    = gl_WorkGroupID.y;
    const uint row0 = gl_WorkGroupID.x * NROWS * (BLOCK_SIZE / SG) + sg * NROWS;

    float acc[NROWS * NTOK * GQA];
    [[unroll]] for (uint i = 0; i < NROWS * NTOK * GQA; ++i) acc[i] = 0.0;

    uint a_base[NROWS];
    [[unroll]] for (uint r = 0; r < NROWS; ++r) {
        a_base[r] = (p.a_offset + h * p.a_chan_stride + min(row0 + r, p.nrows - 1) * p.a_row_stride) / 4;
    }
    const uint b_base = (p.b_offset + h * GQA * p.b_chan_stride) / 4;
    const uint b_cs = p.b_chan_stride / 4;
    const uint b_ts = p.b_tok_stride / 4;
    const uint n4 = p.ncols / 4;

    for (uint k4 = lane; k4 < n4; k4 += SG) {
        vec4 av[NROWS];
        [[unroll]] for (uint r = 0; r < NROWS; ++r) av[r] = vec4(data_a_v4[a_base[r] + k4]);
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                const vec4 bv = data_b_v4[b_base + c * b_cs + t * b_ts + k4];
                [[unroll]] for (uint r = 0; r < NROWS; ++r) acc[(r * NTOK + t) * GQA + c] += dot(av[r], bv);
            }
        }
    }
    [[unroll]] for (uint i = 0; i < NROWS * NTOK * GQA; ++i) acc[i] = subgroupAdd(acc[i]);
    if (lane == 0) {
        [[unroll]] for (uint r = 0; r < NROWS; ++r) {
            if (row0 + r < p.nrows) {
                [[unroll]] for (uint t = 0; t < NTOK; ++t) {
                    [[unroll]] for (uint c = 0; c < GQA; ++c) {
                        data_d[p.d_offset + (h * GQA + c) * p.d_chan_stride + t * p.d_tok_stride + row0 + r] = acc[(r * NTOK + t) * GQA + c];
                    }
                }
            }
        }
    }
}
