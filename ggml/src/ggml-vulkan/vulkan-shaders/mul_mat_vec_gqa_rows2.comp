#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_clustered : enable

// b65 v2 of mul_mat_vec_gqa_rows: dst[i, t, h*GQA + c] = sum_k A[k, i, h] * B[k, t, h*GQA + c] for short k.
// 8 lanes per row: lane j of a row reads k4 = j, j+8, ... (contiguous across the 8 lanes), clustered add of 8.
#define LPR 8
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "mul_mat_vec_iface.glsl"

layout(constant_id = 0) const uint GQA = 1;
layout(constant_id = 1) const uint NTOK = 1;

layout (push_constant) uniform parameter
{
    uint ncols; uint nrows; uint a_row_stride; uint a_chan_stride;
    uint b_chan_stride; uint b_tok_stride; uint d_chan_stride; uint d_tok_stride;
    uint a_offset; uint b_offset; uint d_offset;
    uint mask_offset; uint mask_tok_stride; uint mask_head_stride; uint flags;   // b65
} p;

void main() {
#if defined(DATA_A_IQ4_NL)
    init_iq_shmem(gl_WorkGroupSize);
#endif
    const uint row = gl_GlobalInvocationID.x / LPR;
    const uint j   = gl_GlobalInvocationID.x % LPR;
    const uint h   = gl_WorkGroupID.y;
    const uint rr  = min(row, p.nrows - 1);   // keep every lane active for the clustered add

    float acc[NTOK * GQA];
    [[unroll]] for (uint i = 0; i < NTOK * GQA; ++i) acc[i] = 0.0;

    bool live = true;   // b65: fully masked rows are skipped (their outputs are masked by the softmax anyway)
    if ((p.flags & 1u) != 0u) {
        live = false;
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                live = live || float(data_fuse0[p.mask_offset + t * p.mask_tok_stride + (h * GQA + c) * p.mask_head_stride + rr]) > -1e30;
            }
        }
    }

#if defined(DATA_A_Q8_0) || defined(DATA_A_Q4_0) || defined(DATA_A_IQ4_NL)
    const uint a_base = p.a_offset + h * p.a_chan_stride + rr * p.a_row_stride;   // q8_0 / q4_0 / iq4_nl blocks
#else
    const uint a_base = (p.a_offset + h * p.a_chan_stride + rr * p.a_row_stride) / 4;
#endif
    const uint b_base = (p.b_offset + h * GQA * p.b_chan_stride) / 4;
    const uint b_cs = p.b_chan_stride / 4;
    const uint b_ts = p.b_tok_stride / 4;

#if defined(DATA_A_Q4_0) || defined(DATA_A_IQ4_NL)
    // b65 kv4: 4-bit K cache. Four lanes per block, 8 elements each: the low and high nibbles of 4 bytes (elements
    // m..m+3 and m+16..m+19, m = 4*(j%4)); 64 elements (two blocks) per iteration of the 8 lanes. ncols % 64 == 0.
    for (uint e64 = 0; live && e64 < p.ncols / 64; ++e64) {
        const uint ib = a_base + e64 * 2 + j / 4;
        const uint w = (j % 4) * 2;
        const float dq = float(data_a_packed16[ib].d);
        const uint q = uint(data_a_packed16[ib].qs[w]) | (uint(data_a_packed16[ib].qs[w + 1]) << 16);
#if defined(DATA_A_IQ4_NL)
        const vec4 alo = vec4(kvalues_iq4nl[q & 0xFu], kvalues_iq4nl[(q >> 8) & 0xFu],
                              kvalues_iq4nl[(q >> 16) & 0xFu], kvalues_iq4nl[(q >> 24) & 0xFu]) * dq;
        const vec4 ahi = vec4(kvalues_iq4nl[(q >> 4) & 0xFu], kvalues_iq4nl[(q >> 12) & 0xFu],
                              kvalues_iq4nl[(q >> 20) & 0xFu], kvalues_iq4nl[(q >> 28) & 0xFu]) * dq;
#else
        const vec4 alo = (vec4(q & 0xFu, (q >> 8) & 0xFu, (q >> 16) & 0xFu, (q >> 24) & 0xFu) - 8.0) * dq;
        const vec4 ahi = (vec4((q >> 4) & 0xFu, (q >> 12) & 0xFu, (q >> 20) & 0xFu, (q >> 28) & 0xFu) - 8.0) * dq;
#endif
        const uint k4 = e64 * 16 + (j / 4) * 8 + (j % 4);
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                const uint bb = b_base + c * b_cs + t * b_ts + k4;
                acc[t * GQA + c] += dot(alo, data_b_v4[bb]) + dot(ahi, data_b_v4[bb + 4]);
            }
        }
    }
#else
    for (uint k4 = j; live && k4 < p.ncols / 4; k4 += LPR) {
#if defined(DATA_A_Q8_0)
        const uint ib = a_base + k4 / 8;
        const uint w = (k4 % 8) * 2;
        const float dq = float(data_a_packed16[ib].d);
        const uint v0 = uint(data_a_packed16[ib].qs[w]), v1 = uint(data_a_packed16[ib].qs[w + 1]);
        const vec4 av = vec4(float(int(v0 << 24) >> 24), float(int(v0 << 16) >> 24),
                             float(int(v1 << 24) >> 24), float(int(v1 << 16) >> 24)) * dq;
#else
        const vec4 av = vec4(data_a_v4[a_base + k4]);
#endif
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                acc[t * GQA + c] += dot(av, data_b_v4[b_base + c * b_cs + t * b_ts + k4]);
            }
        }
    }
#endif
    [[unroll]] for (uint i = 0; i < NTOK * GQA; ++i) acc[i] = subgroupClusteredAdd(acc[i], LPR);
    if (j == 0 && row < p.nrows) {
        [[unroll]] for (uint t = 0; t < NTOK; ++t) {
            [[unroll]] for (uint c = 0; c < GQA; ++c) {
                data_d[p.d_offset + (h * GQA + c) * p.d_chan_stride + t * p.d_tok_stride + row] = acc[t * GQA + c];
            }
        }
    }
}
